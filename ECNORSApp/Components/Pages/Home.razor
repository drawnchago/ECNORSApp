    private async Task ShareScreenAsync()
    {
        try
        {
            var isCaptureSupported = Screenshot.Default.IsCaptureSupported;

            if (!isCaptureSupported)
            {
                ToastService.ShowError("Tu dispositivo no soporta captura de pantalla.");
                return;
            }

            var screenshot = await Screenshot.Default.CaptureAsync();

            if (screenshot is null)
            {
                ToastService.ShowError("No se pudo tomar la captura.");
                return;
            }

            var fileName = $"cierre_secuencia_{DateTime.Now:yyyyMMdd_HHmmss}.png";
            var filePath = Path.Combine(FileSystem.CacheDirectory, fileName);

            await using (var stream = await screenshot.OpenReadAsync())
            await using (var fileStream = File.OpenWrite(filePath))
            {
                await stream.CopyToAsync(fileStream);
            }

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Compartir captura",
                File = new ShareFile(filePath)
            });
        }
        catch (Exception ex)
        {
            await FileLogger.ErrorAsync("ShareScreenAsync => " + ex);
            ToastService.ShowError("No se pudo compartir la captura.");
        }
    } 
    private async Task CaptureModalAsync()
    {
        try
        {
            isCaptureMode = true;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(200);

            var dataUrl = await JS.InvokeAsync<string>("captureElement", "modalCapture");

            if (string.IsNullOrWhiteSpace(dataUrl))
            {
                ToastService.ShowError("No se pudo capturar el modal.");
                return;
            }

            var base64Data = dataUrl.Split(',')[1];
            var bytes = Convert.FromBase64String(base64Data);

            var fileName = $"cierre_secuencia_{DateTime.Now:yyyyMMdd_HHmmss}.png";
            var filePath = Path.Combine(FileSystem.CacheDirectory, fileName);

            await File.WriteAllBytesAsync(filePath, bytes);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Compartir captura",
                File = new ShareFile(filePath)
            });
        }
        catch (Exception ex)
        {
            await FileLogger.ErrorAsync("CaptureModalAsync => " + ex);
            ToastService.ShowError("No se pudo compartir la captura.");
        }
        finally
        {
            isCaptureMode = false;
            await InvokeAsync(StateHasChanged);
        }
    } 

    private static string FormatTotalizer(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "0.00";

        var normalized = value.Trim().Replace(",", ""); 
        return decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var n) ? n.ToString("N2", CultureInfo.InvariantCulture) : value;
    }

    private async Task RefreshBinnacleModalDataAsync()
    {
        if (selectedBinnacle is null || string.IsNullOrWhiteSpace(selectedName))
            return;

        var bin = await WaitBinnacleBySequenceAsync(selectedName, selectedBinnacle.id);

        if (bin is not null)
        {
            selectedBinnacle = bin;
            await FileLogger.InfoAsync($"REFRESH BIN => Obs='{selectedBinnacle?.Observations}' Closed={selectedBinnacle?.Closed}");
        }
        else
        {
            await FileLogger.InfoAsync("RefreshBinnacleModalDataAsync | No se obtuvo bitácora actualizada.");
        }
         
        var obs = selectedBinnacle?.Observations?.Trim().ToUpperInvariant();

        bool debeConsultarTrx =
            selectedBinnacle?.Closed == true &&
            (obs == "CERRADA" || obs == "CERRADA_MANUAL");

        if (debeConsultarTrx)
        {
            var trx = await CloseLoadApi.GetTransactionBySequenceAsync(selectedName, selectedBinnacle!.id);

            if (trx is not null)
            {
                selectedTransaction = trx;

                inputGross = (decimal?)(trx.Volume ?? 0d);
                inputNet = (decimal?)(trx.Amount ?? 0d);
                inputTemperature = (decimal?)(trx.UnitPrice ?? 0d);
                inputTotalizadorFinal = ParseDecimalOrZero(trx.strTotalizadorFinal);

                await FileLogger.InfoAsync($"REFRESH TRX => Secuencia={selectedBinnacle.id} TransactionId={trx.TransactionId}");
            }
            else
            {
                selectedTransaction = null;
                await FileLogger.InfoAsync($"REFRESH TRX => SIN TRX Secuencia={selectedBinnacle?.id}");
            }
        }
        else
        {
            selectedTransaction = null;
            await FileLogger.InfoAsync($"REFRESH TRX => NO APLICA Obs='{obs}'");
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task LoadAsync()
    {
        if (!isConnected || string.IsNullOrWhiteSpace(selectedName) || !selectedDispensaryId.HasValue)
            return;

        isLoadingTables = true;
        tablesError = null;
        transactions.Clear();
        binnacle.Clear();
        StateHasChanged();

        try
        {
            var dispId = selectedDispensaryId.Value;
            var bTask = CloseLoadApi.GetBinnacleTopByDayAsync(selectedName, dispId, selectedDay);
            var tTask = CloseLoadApi.GetTransactionsTopAsync(selectedName, dispId);

            await Task.WhenAll(bTask, tTask);

            binnacle = (await bTask).ToList();
            transactions = (await tTask).ToList();

            if (!binnacle.Any() && !transactions.Any())
                ToastService.ShowInfo("No se encontraron registros.");
        }
        catch (Exception ex)
        {
            await FileLogger.ErrorAsync("ReloadTablesAsync => " + ex);
            ToastService.ShowError("Error al refrescar la bitácora y/o transacciones");
        }
        finally
        {
            isLoadingTables = false;
            StateHasChanged();
        }
    }
