    private async Task CloseModalAsync(bool isBinnacle, bool reload = true)
    {
        if (isBinnacle)
        {
            showBinnacleModal = false;
            selectedBinnacle = null;
        }
        else
        {
            showTransactionModal = false;
            selectedTransaction = null;
        }

        if (reload)
            await LoadAsync();
    }

    private async Task SaveModalAsync()
    {
        isSavingModal = true;

        try
        {
            bool ok = false;
            var previousObservation = selectedBinnacle?.Observations;

            if (isCloseMode)
                ok = await SaveForcedCloseAsync();
            else if (isUpdateTrans)
                ok = await SaveTransactionUpdateAsync();
            else if (isCloseManual)
                ok = await SaveManualCloseAsync();

            if (!ok)
                return;

            if (selectedBinnacle is not null)
            {
                var trx = await CloseLoadApi.GetTransactionBySequenceAsync(selectedName, selectedBinnacle.id);

                if (trx is not null)
                    selectedTransaction = trx;

                Console.WriteLine("selectedBinnacle.id =>" + selectedBinnacle.id);
                var bin = await WaitBinnacleBySequenceAsync(
                    selectedName,
                    selectedBinnacle.id);

                if (bin is not null)
                {
                    selectedBinnacle = bin;

                    await FileLogger.InfoAsync( $"FINAL OBS => '{selectedBinnacle?.Observations}'"); 
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await FileLogger.InfoAsync("SaveModalAsync | No se obtuvo bitácora actualizada.");
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await FileLogger.ErrorAsync("SaveModalAsync => " + ex);
            ToastService.ShowError(ex.Message, "Error");
        }
        finally
        {
            isSavingModal = false;
            StateHasChanged();
        }
    }

    private async Task<BinnacleDto?> WaitBinnacleBySequenceAsync(string station,long secuencia,CancellationToken ct = default)
    {
        BinnacleDto? last = null;

        for (int i = 0; i < 2; i++)
        {
            var bin = await CloseLoadApi.GetBinnacleBySequenceAsync(station, secuencia, ct);

            await FileLogger.InfoAsync($"Intento {i + 1} => Obs: '{bin?.Observations}'");

            if (bin is not null)
            {
                last = bin;
                 
                if (!string.IsNullOrWhiteSpace(bin.Observations))
                    return bin;
            }
             
        }

        return last;
    }
    private async Task<bool> SaveTransactionUpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedName))
        {
            ToastService.ShowError("No hay estación seleccionada.");
            return false;
        }

        if (selectedTransaction is null)
        {
            ToastService.ShowError("No hay transacción seleccionada.");
            return false;
        }

        if (!ValidateManualInputs())
            return false;
            
        var dto = new TransactionUpdateDto
        {
            Station = selectedName,
            TransactionId = selectedTransaction.TransactionId,
            UnitPrice = (double)inputTemperature!.Value,
            Volume = (double)inputGross!.Value,
            Amount = (double)inputNet!.Value,
            strTotalizadorFinal = inputTotalizadorFinal?.ToString(CultureInfo.InvariantCulture)
        };

        var resp = await CloseLoadApi.UpdateTransactionBySequenceAsync(dto);

        if (!resp.Success)
        {
            await FileLogger.ErrorAsync($"SaveTransactionUpdateAsync | Negocio | Station={selectedName} TransactionId={selectedTransaction.TransactionId} Msg={resp.Message}");
            ToastService.ShowError(resp.Message ?? "No se pudo actualizar la transacción.");
            return false;
        }

        await FileLogger.InfoAsync($"SaveTransactionUpdateAsync | OK | Station={selectedName} TransactionId={selectedTransaction.TransactionId}");
        ToastService.ShowSuccess(resp.Message ?? "Transacción actualizada.");
        return true;
    }

    private async Task<bool> SaveManualCloseAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedName))
        {
            ToastService.ShowError("No hay estación seleccionada.");
            return false;
        }

        if (selectedBinnacle is null)
        {
            ToastService.ShowError("No hay secuencia seleccionada.");
            return false;
        }

        if (!ValidateManualInputs())
            return false;
            
        Console.WriteLine($"ValidateManualInputs");
        Console.WriteLine($"Station: {selectedName}");
        Console.WriteLine($"secuenciaBuscar: selectedBinnacle.id: {selectedBinnacle.id}");
        Console.WriteLine($"inputGross!.Value: {inputGross!.Value}");
        Console.WriteLine($"inputNet!.Value: {inputNet!.Value}");
        Console.WriteLine($"iinputTemperature!.Value: {inputTemperature!.Value}");
        await CloseLoadApi.CloseManualAsync(
            station: selectedName,
            secuenciaBuscar: selectedBinnacle.id,
            volumenGross: inputGross!.Value,
            volumenNetoCt: inputNet!.Value,
            temperatura: inputTemperature!.Value
        );
        
        Console.WriteLine($"CloseManualAsync");
        await FileLogger.InfoAsync($"SaveManualCloseAsync | OK | Station={selectedName} Secuencia={selectedBinnacle.id}");
        ToastService.ShowSuccess("La carga fue cerrada correctamente.");
        return true;
    }

    private bool ValidateManualInputs()
    {
        if (!inputGross.HasValue || inputGross.Value <= 0)
        {
            ToastService.ShowError("Debe capturar un volumen bruto válido.");
            return false;
        }

        if (!inputNet.HasValue || inputNet.Value <= 0)
        {
            ToastService.ShowError("Debe capturar un monto neto válido.");
            return false;
        }

        if (!inputTemperature.HasValue || inputTemperature.Value == 0)
        {
            ToastService.ShowError("Debe capturar una temperatura válida.");
            return false;
        }

        return true;
    }

    private async Task<bool> SaveForcedCloseAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedName))
