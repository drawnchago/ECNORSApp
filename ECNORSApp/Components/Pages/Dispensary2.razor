@page "/dispensary2"
@using MudBlazor
@using ECNORSAppData.Data.Config
@using ECNORSAppData.Data.DTO
@using ECNORSApp.Services
@using Microsoft.AspNetCore.Components.Web

@inject IToastService ToastService
@inject IFileLoggerService FileLogger
@inject IConnectionSelector ConnectionSelector
@inject CloseLoadApi CloseLoadApi

<div class="page-header">
    <h3>Dispensarios</h3>
</div> 
<div class="dispensary-page" @ontouchstart="HandleTouchStart" @ontouchend="HandleTouchEnd">
@if (isLoadingDispensaries)
{
    <div class="loading-container">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Class="mt-2">Cargando estatus...</MudText>
    </div>
}
else if (!string.IsNullOrWhiteSpace(dispensariesError))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@dispensariesError</MudAlert>
}
    else if (dispensariesByStationOrdered.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">No se encontraron dispensarios.</MudAlert>
}
else
{
    <MudTabs @bind-ActivePanelIndex="selectedTabIndex" Rounded="true" Border="true" Elevation="2" Centered="true" ScrollButtons="false" Class="station-tabs" PanelClass="station-tab-panel"> 
        @foreach (var group in dispensariesByStationOrdered)
        {
            <MudTabPanel Text="@group.Key">
                <TabContent>
                    <MudIcon Icon="@Icons.Material.Filled.LocalGasStation" />
                    <span class="ml-1">@group.Key</span>
                </TabContent>

                <ChildContent>
                    <div class="station-body">
                        <div class="station-summary mt-2 d-flex justify-space-between align-center">
                            <div>
                                <div class="station-title">@group.Key</div>
                                <div class="station-subtitle">Dispensarios registrados: @group.Value.Count </div>
                            </div> 
                                <div class="d-flex align-center" style="gap:8px;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Small" OnClick="ToggleLegend" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="LoadDispensariesAsync">Actualizar</MudButton>
                                </div>
                        </div>

                        @if (openLegend)
                        {
                            <div class="legend-bar"> 
                                    <div class="legend-title">Código de color:</div>
                                    @foreach (var item in DispensaryStatusMap.Items.Values)
                                    {
                                        <div class="legend-item">
                                            <span class="dot @(item.Id == 2 ? "light" : "")" style="background:@item.Color"></span>
                                            <div>
                                                <div class="legend-code">@item.Code</div>
                                                <div class="legend-desc">@item.Description</div>
                                            </div>
                                        </div>
                                    }  
                            </div>
                        }
                        <div class="table-wrapper">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Estatus</th>
                                        <th>Generado</th>
                                        <th>Sirviendo</th>
                                        <th>Despacho</th>
                                    </tr>
                                </thead>
                                <tbody>
                                        @foreach (var item in group.Value)
                                        {
                                            var status = DispensaryStatusMap.Get(item.Estatus);

                                            <tr>
                                                <td>#@item.DispensaryId</td>
                                                <td> <span class="badge" style="background-color:@status.Color; color:@StatusTextColor(status.Id); border:@StatusBorder(status.Id);"> @status.Code </span> </td>
                                                <td><span class="badge  @BoolClass(item.Generado)"> @BoolText(item.Generado)</span></td> 
                                                <td><span class="badge @BoolClass(item.Sirviendo)"> @BoolText(item.Sirviendo) </span></td> 
                                                <td><span class="badge @BoolClass(item.Despacho)"> @BoolText(item.Despacho)</span> </td>
                                            </tr>
                                        }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </ChildContent>
            </MudTabPanel>
        }
    </MudTabs>
}

@* <style>
    .station-tabs .mud-tabs-scroll-button,
    .station-tabs .mud-tab-prev-button,
    .station-tabs .mud-tab-next-button,
    .station-tabs button[aria-label*="scroll"],
    .station-tabs button[aria-label*="Scroll"] {
        display: none !important;
        width: 0 !important;
        min-width: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
    }
</style> *@
</div>
@code {
    private int selectedTabIndex = 0;
    private bool isLoadingDispensaries = false;
    private string? dispensariesError = null;
    private double touchEndX = 0;
    private double touchStartX = 0;
    private bool openLegend = false;

    private static string StatusTextColor(int id) => id == 2 ? "black" : "white";
    private static string StatusBorder(int id) => id == 2 ? "1px solid #ccc" : "none";
    private static string BoolClass(bool v) => v ? "ok" : "fail";
    private static string BoolText(bool v) => v ? "Sí" : "No";

    private Dictionary<string, List<DispensaryDto>> dispensariesByStation = new(); 
    private List<KeyValuePair<string, List<DispensaryDto>>> dispensariesByStationOrdered = new();

    protected override async Task OnInitializedAsync() => await LoadDispensariesAsync();

    private void HandleTouchStart(TouchEventArgs e) => touchStartX = e.Touches[0].ClientX; 
    private void ToggleLegend() => openLegend = !openLegend;

    private void NextTab()
    {
        if (dispensariesByStationOrdered.Count == 0)
            return;

        selectedTabIndex = (selectedTabIndex + 1) % dispensariesByStationOrdered.Count;
    }

    private void PrevTab()
    {
        if (dispensariesByStationOrdered.Count == 0)
            return;

        selectedTabIndex = (selectedTabIndex - 1 + dispensariesByStationOrdered.Count) % dispensariesByStationOrdered.Count;
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        touchEndX = e.ChangedTouches[0].ClientX;
        var diff = touchEndX - touchStartX;

        if (Math.Abs(diff) < 50)
            return;

        if (diff < 0)
            NextTab();
        else
            PrevTab();
    }
    
    private List<ConnItem> GetVisibleStations() => ConnectionSelector.GetConnections() .Where(x => !string.IsNullOrWhiteSpace(x.name) && !x.name.Equals("Laboratorio", StringComparison.OrdinalIgnoreCase)) .ToList();

    private async Task LoadDispensariesAsync()
    {
        isLoadingDispensaries = true;
        dispensariesError = null;

        try
        {
            dispensariesByStation.Clear();
            var stations = GetVisibleStations();

            foreach (var station in stations)
            {
                try
                {
                    if (string.IsNullOrWhiteSpace(station.name))
                        continue;

                    var list = await CloseLoadApi.GetDispensariosAsync(station.name);

                    foreach (var item in list)
                    {
                        item.StationName = station.name;
                    }

                    dispensariesByStation[station.name] = list.OrderBy(x => x.DispensaryId).ToList();
                }
                catch (Exception exConn)
                {
                    await FileLogger.ErrorAsync($"Error en modulo Dispensarios al obtener dispensarios de {station.name}: {exConn}");
                }
            }
            dispensariesByStationOrdered = dispensariesByStation.OrderBy(x => x.Key).ToList(); 
        }
        catch (Exception ex)
        {
            dispensariesError = ex.Message;
            await FileLogger.ErrorAsync("Error modulo dispensarios en LoadDispensariesAsync => " + ex);
            ToastService.ShowError(ex.Message, "Error en modulo Dispensarios al obtener dispensarios ");
        }
        finally
        {
            isLoadingDispensaries = false; 
        }
    }
}